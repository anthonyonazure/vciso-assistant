ANTHROPIC_API_KEY=
VCISO_MODEL=claude-sonnet-4-6

# Database (SQLite default)
VCISO_DATABASE_URL=sqlite+aiosqlite:///./vciso.db

# Path to the policy knowledge base (reuses the SQR format)
VCISO_KNOWLEDGE_BASE=knowledge_base/cyber_co.yaml

# Slack — for the interactive Q&A bot. Bot scopes:
#   chat:write, app_mentions:read, im:history, im:read, im:write
VCISO_SLACK_BOT_TOKEN=
VCISO_SLACK_SIGNING_SECRET=
